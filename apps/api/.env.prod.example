APP_NAME=Oxubiraz
APP_ENV=production
APP_KEY=                          # php artisan key:generate --show
APP_DEBUG=false
APP_TIMEZONE=Asia/Baku
APP_URL=https://api.oxubiraz.az
APP_LOCALE=az
APP_FALLBACK_LOCALE=en

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=stderr
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=mysql                     # docker-compose service name
DB_PORT=3306
DB_DATABASE=oxubiraz
DB_USERNAME=oxubiraz
DB_PASSWORD=                      # strong random password

MYSQL_ROOT_PASSWORD=              # separate strong random password
MYSQL_DATABASE=oxubiraz
MYSQL_USER=oxubiraz
MYSQL_PASSWORD=                   # same as DB_PASSWORD

# Redis
REDIS_CLIENT=predis
REDIS_HOST=redis                  # docker-compose service name
REDIS_PASSWORD=                   # strong random password
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1

SESSION_DRIVER=redis
SESSION_LIFETIME=1440
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=.oxubiraz.az

BROADCAST_CONNECTION=pusher
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
CACHE_PREFIX=oxubiraz_prod

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@oxubiraz.az"
MAIL_FROM_NAME="Oxubiraz"

# Pusher
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=eu

# Web Push (VAPID) — generate with: php artisan webpush:vapid
VAPID_SUBJECT=mailto:noreply@oxubiraz.az
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Sanctum
SANCTUM_STATEFUL_DOMAINS=oxubiraz.az
SANCTUM_TOKEN_EXPIRATION=1440

# Frontend
FRONTEND_URL=https://oxubiraz.az

# File Upload
MAX_FILE_SIZE=10240
ALLOWED_IMAGE_TYPES=jpg,jpeg,png,webp,gif

# Rate Limiting
THROTTLE_API=60
THROTTLE_AUTH=10
THROTTLE_GAME=120

# AI (OpenAI)
OPENAI_API_KEY=
OPENAI_ORGANIZATION=
OPENAI_MODEL=gpt-4o-mini

# Sentry
SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.05

# Horizon (queue monitor dashboard)
# Dashboard is at: https://api.oxubiraz.az/horizon
HORIZON_USERNAME=                 # HTTP basic auth username
HORIZON_PASSWORD=                 # HTTP basic auth password
HORIZON_PREFIX=oxubiraz_horizon:

# Docker registry (used by Makefile and CD pipeline)
REGISTRY=ghcr.io/your-org/oxubiraz
API_TAG=latest
WEB_TAG=latest
