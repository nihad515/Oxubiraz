# ─────────────────────────────────────────────────────────────────────────────
# Oxubiraz — Production Environment Template
# Copy this file to .env.prod on the server and fill in every value.
# NEVER commit the real .env.prod to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ─── Docker Registry ─────────────────────────────────────────────────────────
REGISTRY=ghcr.io/your-org/oxubiraz
API_TAG=latest
WEB_TAG=latest

# ─── MySQL ───────────────────────────────────────────────────────────────────
MYSQL_ROOT_PASSWORD=change-me-root-password
MYSQL_DATABASE=oxubiraz
MYSQL_USER=oxubiraz
MYSQL_PASSWORD=change-me-db-password

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_PASSWORD=change-me-redis-password

# ─── Laravel API ─────────────────────────────────────────────────────────────
APP_NAME=Oxubiraz
APP_ENV=production
APP_KEY=base64:GENERATE_WITH_php_artisan_key_generate
APP_DEBUG=false
APP_TIMEZONE=Asia/Baku
APP_URL=https://api.oxubiraz.az
APP_LOCALE=az
APP_FALLBACK_LOCALE=en

BCRYPT_ROUNDS=14

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=oxubiraz
DB_USERNAME=oxubiraz
DB_PASSWORD=change-me-db-password

REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PASSWORD=change-me-redis-password
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1

SESSION_DRIVER=redis
SESSION_LIFETIME=1440
SESSION_ENCRYPT=true
SESSION_DOMAIN=.oxubiraz.az

BROADCAST_CONNECTION=pusher
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
CACHE_STORE=redis
CACHE_PREFIX=oxubiraz_prod

MAIL_MAILER=smtp
MAIL_HOST=smtp.mailgun.org
MAIL_PORT=587
MAIL_USERNAME=postmaster@mg.oxubiraz.az
MAIL_PASSWORD=change-me-mailgun-key
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@oxubiraz.az
MAIL_FROM_NAME=Oxubiraz

PUSHER_APP_ID=change-me
PUSHER_APP_KEY=change-me
PUSHER_APP_SECRET=change-me
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=eu

# Generate with: docker compose -f docker-compose.prod.yml exec -T api php artisan webpush:vapid
VAPID_SUBJECT=mailto:noreply@oxubiraz.az
VAPID_PUBLIC_KEY=change-me
VAPID_PRIVATE_KEY=change-me

SANCTUM_STATEFUL_DOMAINS=oxubiraz.az,www.oxubiraz.az
SANCTUM_TOKEN_EXPIRATION=1440

FRONTEND_URL=https://oxubiraz.az

MAX_FILE_SIZE=10240
ALLOWED_IMAGE_TYPES=jpg,jpeg,png,webp,gif

THROTTLE_API=60
THROTTLE_AUTH=10
THROTTLE_GAME=120

OPENAI_API_KEY=sk-change-me
OPENAI_ORGANIZATION=
OPENAI_MODEL=gpt-4o-mini

SENTRY_LARAVEL_DSN=https://change-me@o0.ingest.sentry.io/0
SENTRY_TRACES_SAMPLE_RATE=0.05

# Horizon dashboard auth — set a strong password
HORIZON_USERNAME=horizon
HORIZON_PASSWORD=change-me-horizon-password
HORIZON_PREFIX=oxubiraz_
